// The patterns the program carries with it, as the RLE text LifeWiki publishes them.
//
// They are kept as text rather than as cell lists so that every one of them goes through the same
// reader a pattern file does, and the tests read each of them back.

val GLIDER: string = """
    #N Glider
    x = 3, y = 3, rule = B3/S23
    bob$2bo$3o!
    """

val R_PENTOMINO: string = """
    #N R-pentomino
    #C A methuselah: five cells that take 1103 generations to settle.
    x = 3, y = 3, rule = B3/S23
    b2o$2ob$bo!
    """

val ACORN: string = """
    #N Acorn
    #C A methuselah found by Charles Corderman.
    x = 7, y = 3, rule = B3/S23
    bo5b$3bo3b$2o2b3o!
    """

val GOSPER_GUN: string = """
    #N Gosper glider gun
    #C The first known gun, found by Bill Gosper in 1970; it fires a glider every 30 generations.
    x = 36, y = 9, rule = B3/S23
    24bo$22bobo$12b2o6b2o12b2o$11bo3bo4b2o12b2o$2o8bo5bo3b2o$2o8bo3bob2o4b
    obo$10bo5bo7bo$11bo3bo$12b2o!
    """

val PULSAR: string = """
    #N Pulsar
    x = 13, y = 13, rule = B3/S23
    2b3o3b3o2b2$o4bobo4bo$o4bobo4bo$o4bobo4bo$2b3o3b3o2b2$2b3o3b3o2b$o4bobo4bo$
    o4bobo4bo$o4bobo4bo2$2b3o3b3o!
    """

val BRIANS_BRAIN: string = """
    #N Brian's Brain: two spaceships head on
    #C Generations /2/3: each ship is two live cells with two dying ones behind, and moves a cell a
    #C generation.
    x = 12, y = 2, rule = /2/3
    BA8.AB$BA8.AB!
    """

val STAR_WARS: string = """
    #N Star Wars soup
    #C Generations 345/2/4, from a random 16 by 16 block of live and dying cells.
    x = 16, y = 16, rule = 345/2/4
    2.AB2.A2.A.A3.A$A3.2A.A2.2BA.2A$A3.A2.A.A.A.AB$.2AB3.AB.A.A.AB$2A.3A4.B2.A.A$
    A.BA.A2.2A3.2A$B.2A2.B.4A3.A$2B2.2B.BABA.BAB$.A2.A.A4.B.3A$2.3A2.2A.BA.BA$
    5.B2.2A5.A$A.2A2.B2A3B.ABA$4A.ABA4.A$A3.A.A2.A3.2A$B2.A.A2.4A$B.B.AB.A2.A2.BA!
    """

val RULE_110: string = """
    #N Rule 110 from one cell
    #C Matthew Cook proved this one-dimensional rule capable of universal computation.
    x = 1, y = 1, rule = W110
    o!
    """

// Every bundled pattern: the first five in the order the viewer's number keys offer them, the rest
// in the order its `0` key steps through.
bundled() -> []string = [GLIDER, R_PENTOMINO, ACORN, GOSPER_GUN, PULSAR, BRIANS_BRAIN, STAR_WARS, RULE_110]

// How many patterns the number keys offer; `0` steps through the rest.
const KEYED: int = 5

// The rules the viewer's number keys offer, as the notation a person would type.
preset_rules() -> []string = ["B3/S23", "B36/S23", "B2/S", "B3678/S34678"]
