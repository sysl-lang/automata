// Run-length encoded patterns, the format Golly and LifeWiki publish patterns in.
//
//     #N Glider
//     #C A comment line.
//     x = 3, y = 3, rule = B3/S23
//     bob$2bo$3o!
//
// Lines starting with `#` come first; `#N` names the pattern and the rest are skipped. The header
// gives the bounding box and, optionally, the rule. The body is runs of `b` (dead) and `o` (alive),
// each with an optional count in front, `$` ending a row (a count in front of it ends that many), and
// `!` ending the pattern. Whitespace and line breaks between items are ignored, and so is everything
// after the `!`.
//
// **A pattern with more than two states writes them as Golly does**: `.` is state 0, `A` to `X` are
// states 1 to 24, and a lower-case letter from `p` to `y` in front moves on by 24 for each step past
// `o` — `pA` is 25, `qA` is 49, up to `yO`, 255. `b` and `o` are `.` and `A` again, so a two-state
// pattern is one of these. Such a pattern's header spells a Generations rule (`rule = /2/3`) or names
// a rule (`rule = WireWorld`), which then comes from a rule file.

import sh.sysl.parsing.{Diagnostic, Scanner, Span, error, read_digits, scanner_of, where}
import sysl.buf.{Buf, buf}

struct Cell
    x: int
    y: int
    state: u8

struct Pattern
    name: string
    width: int
    height: int
    // The rule the header names, if it spells one in a notation `parse_rule` reads.
    rule: Option[Rule]
    // The rule the header names by name instead, such as `WireWorld`, or "".
    rule_name: string
    // The cells not in state 0, relative to the pattern's top-left corner.
    live: Buf[Cell]

    // Draw the pattern into `g` with its top-left corner at `x`, `y`. Cells off a bounded grid are
    // dropped; on a torus they wrap.
    stamp(self, g: *Grid, x: int, y: int)
        for i in 0..<self.live.len()
            val c = self.live[i]

            if c.state == 1 then g.set(x + c.x, y + c.y, true) else g.set_state(x + c.x, y + c.y, c.state)

    // The highest state any cell is in, 0 for an empty pattern.
    most_state(self) -> u8
        var most: u8 = 0

        for i in 0..<self.live.len()
            if self.live[i].state > most then most = self.live[i].state

        most

    // Draw it centred; under a Wolfram rule at the top, centred across, since the rows below it are
    // its future.
    stamp_centred(self, g: *Grid)
        val top = if self.rule is Some(Wolfram(_)) then 0 else (g.height - self.height) / 2

        self.stamp(g, (g.width - self.width) / 2, top)
end Pattern

// Read an RLE pattern. A refusal is a diagnostic whose span points into `text`.
parse_rle(text: string) -> Result[Pattern, Diagnostic]
    var s = scanner_of(text)
    var name = ""

    // The comment lines, and any blank lines among them.
    loop
        s.skip_space()

        if !s.accept(u8('#')) then break

        if s.accept(u8('N'))
            s.skip_blanks()

            val m = s.mark()

            s.skip_to_line_end()
            name = text[m..<s.offset].trim()
        else
            s.skip_to_line_end()

    if s.at_end() then return Err(error(s.here(), "the pattern has no `x = …, y = …` header"))

    val width = header_number(&s, u8('x'))?

    s.skip_blanks()

    if !s.accept(u8(',')) then return Err(error(s.here(), "expected `,` after the width"))

    val height = header_number(&s, u8('y'))?
    var rule: Option[Rule] = None
    var rule_name = ""

    s.skip_blanks()

    if s.accept(u8(','))
        s.skip_blanks()

        if !s.accept_seq("rule".bytes) then return Err(error(s.here(), "expected `rule = …` after the height"))

        s.skip_blanks()

        if !s.accept(u8('=')) then return Err(error(s.here(), "expected `=` after `rule`"))

        val m = s.mark()

        s.skip_to_line_end()

        val given = text[m..<s.offset].trim()

        if names_a_rule(given)
            rule_name = given
        else
            parse_rule(text[m..<s.offset]) match
                Ok(r) -> rule = Some(r)
                Err(d) -> return Err(shifted(d, m))

    s.skip_blanks()

    if !s.at_end() && !s.accept_newline() then return Err(error(s.here(), "unexpected text after the header"))

    val live: Buf[Cell] = buf()

    read_body(&s, width, height, live)?

    Ok(Pattern(name, width, height, rule, rule_name, live))
end parse_rle

// Whether a header's rule is a name, as Golly's rule files are named, rather than B/S notation: a
// letter, then letters, digits, `-` and `_`, and not a `B` or `S` followed by a count or a `/`.
private names_a_rule(text: string) -> bool
    val b = text.bytes

    if b.len == 0 || !b[0].is_alpha() then return false

    val letter = b[0] | 0x20

    if b.len > 1 && (letter == u8('b') || letter == u8('s')) && (b[1].is_digit() || b[1] == u8('/')) then return false

    var digits = true

    for i in 0..<b.len
        if !b[i].is_alnum() && b[i] != u8('-') && b[i] != u8('_') then return false

        if i > 0 && !b[i].is_digit() then digits = false

    // `W` and a number is a Wolfram code, which Golly reads as a rule of its own.
    !(letter == u8('w') && b.len > 1 && digits)

// `x = 3` or `y = 3`, with blanks anywhere between.
private header_number(s: *Scanner, key: u8) -> Result[int, Diagnostic]
    s.skip_blanks()

    if !s.accept(key) then return Err(error(s.here(), s"expected `${char(key)} =` in the header"))

    s.skip_blanks()

    if !s.accept(u8('=')) then return Err(error(s.here(), s"expected `=` after `${char(key)}`"))

    s.skip_blanks()

    read_count(s)

// A run of decimal digits, as an `int`.
private read_count(s: *Scanner) -> Result[int, Diagnostic]
    val m = s.mark()

    read_digits(s, 10) match
        Ok(n) ->
            if n > 1_000_000 then return Err(error(s.span_from(m), "the number is larger than any pattern this reads"))

            Ok(int(n))
        Err(e) -> Err(error(where(e), "expected a number"))

// The runs, from just after the header to the `!`.
private read_body(s: *Scanner, width: int, height: int, live: Buf[Cell]) -> Result[unit, Diagnostic]
    var x = 0
    var y = 0

    loop
        s.skip_space()

        val m = s.mark()
        var n = 1

        if s.peek().map(c -> c.is_digit()).unwrap_or(false)
            n = read_count(s)?

            if n == 0 then return Err(error(s.span_from(m), "a run count must be at least 1"))

            s.skip_space()

        val tag = s.peek() match
            Some(c) -> c
            None -> return Err(error(s.here(), "the pattern ends without its closing `!`"))

        val state = cell_state(s)?
        val at = Span(m, s.offset + 1)

        if state >= 0
            if x + n > width then return Err(error(at, s"row ${y + 1} is wider than the header's x = ${width}"))

            if state > 0
                if y >= height then return Err(error(at, s"more rows than the header's y = ${height}"))

                for i in 0..<n
                    live.push(Cell(x + i, y, u8(state)))

            x += n
        elif tag == u8('$')
            x = 0
            y += n
        elif tag == u8('!')
            s.bump()
            return Ok(())
        else
            return Err(error(Span(s.offset, s.offset + 1),
                s"`${char(tag)}` is not a cell (`b`, `o`, `.`, `A`…`X`, `pA`…`yO`), `$$` or `!`"))

        s.bump()
end read_body

// The state of the cell at the cursor, leaving the cursor on its last letter; -1 if what is there is
// not a cell.
private cell_state(s: *Scanner) -> Result[int, Diagnostic]
    val c = s.peek().unwrap()

    if c == u8('b') || c == u8('.') then return Ok(0)

    if c == u8('o') then return Ok(1)

    if c >= u8('A') && c <= u8('X') then return Ok(int(c - u8('A')) + 1)

    if c < u8('p') || c > u8('y') then return Ok(-1)

    val at = Span(s.offset, s.offset + 2)
    val letter = s.peek_at(1).unwrap_or(0)
    val state = 24 * int(c - u8('o')) + int(letter - u8('A')) + 1

    if letter < u8('A') || letter > u8('X') || state > 255
        return Err(error(at, s"`${char(c)}` begins a state from `${char(c)}A`, and is followed by `A` to `X` up to state 255"))

    s.bump()
    Ok(state)

// A diagnostic about a piece of a text, moved to where that piece sits in the whole.
private shifted(d: Diagnostic, by: usize) -> Diagnostic =
    Diagnostic(d.severity, Span(d.span.start + by, d.span.end + by), d.message, d.label, d.note)
