// What a cell becomes, as a value the grid is stepped by.
//
// **A rule is data, not a name.** Any rule a person can write down in a notation this reader knows is
// one the grid can run; the handful the viewer offers on its number keys are just strings parsed by
// the same function a typed rule, a `--rule` argument or an RLE header goes through. A rule family
// with a different neighbourhood or more than two states is another variant here, with its own arm in
// `Grid.step`, and everything that only carries a rule around is unaffected — a Golly rule table is
// the second such family.

import sh.sysl.parsing.{Diagnostic, Scanner, Span, error, read_digits, scanner_of}

enum Rule
    // A Life-like rule: a cell's next state depends on its own state and on how many of its eight
    // neighbours are alive. Bit `n` of `birth` says a dead cell with `n` live neighbours comes alive;
    // bit `n` of `survive` says a live cell with `n` stays alive. Conway's Life is B3/S23: births
    // `{3}`, survivals `{2, 3}`.
    LifeLike(birth: u16, survive: u16)
    // An isotropic non-totalistic rule: what a cell becomes depends on its own state and on the
    // arrangement its live neighbours make, up to rotation and reflection.
    Isotropic(rule: Hensel)
    // A rule read from a Golly `.rule` file, as a table or a tree: up to 256 states, on a Moore or
    // von Neumann neighbourhood.
    Table(table: RuleTable)
    // A Generations rule: a Life-like or isotropic rule whose live cells, instead of dying, fade
    // through dying states first.
    Generations(rule: GenerationsRule)
    // One of Wolfram's elementary rules: a line of cells, each becoming what its own state and its
    // two neighbours' say. The grid holds the line's history, one generation to a row.
    Wolfram(code: u8)

    // The rule as a person names it: B/S notation, counts in ascending order, which `parse_rule` reads
    // back to the same rule; Hensel notation in Golly's canonical spelling; Generations in Golly's
    // survivals, births and states (`345/2/4`); `W` and the code; or a table's name from its @RULE
    // line.
    notation(self) -> string
        self match
            LifeLike(b, s) -> s"B${counts(b)}/S${counts(s)}"
            Isotropic(h) -> h.notation()
            Table(t) -> t.name
            Generations(g) -> s"${written(g.life.survive)}/${written(g.life.birth)}/${g.states}"
            Wolfram(code) -> s"W${code}"

    // Whether two rules make every cell the same: a B/S rule and the Hensel rule naming every
    // arrangement of the same counts are one rule, and so is a Generations rule of two states.
    same(self, other: Rule) -> bool
        (two_state(self), two_state(other)) match
            (Some((b1, s1)), Some((b2, s2))) -> return b1 == b2 && s1 == s2
            _ -> ()

        (self, other) match
            (Table(t1), Table(t2)) -> t1.name == t2.name && t1.states == t2.states && t1.next == t2.next && t1.tree == t2.tree
            (Generations(g1), Generations(g2)) ->
                g1.states == g2.states && g1.life.birth == g2.life.birth && g1.life.survive == g2.life.survive
            (Wolfram(c1), Wolfram(c2)) -> c1 == c2
            _ -> false
end Rule

// A Generations rule. A dead cell is born and a live one survives as `life` says; **a live cell that
// does not survive is not dead yet**: it goes through states 2, 3, … a generation at a time, whatever
// is around it, and is dead after `states - 1`. Only a live cell, state 1, counts as a neighbour.
struct GenerationsRule
    life: Hensel
    // Whether any count was narrowed by letters. A rule without them is stepped by counting
    // neighbours, and one with them by their arrangement.
    lettered: bool
    states: int

    // What a cell in `state` becomes, `next` being what `life` says of it: whether a dead cell is
    // born, whether a live one survives. A dying cell ignores it.
    after(self, state: u8, next: bool) -> u8
        if state == 0 then return if next then 1 else 0

        if state == 1 && next then return 1

        if int(state) + 1 == self.states then 0 else state + 1

// The births and survivals of a rule with two states, as sets of arrangements; none for the rest.
private two_state(r: Rule) -> Option[(u64, u64)] =
    r match
        LifeLike(b, s) -> Some((set_of(b), set_of(s)))
        Isotropic(h) -> Some((h.birth, h.survive))
        Generations(g) -> if g.states == 2 then Some((g.life.birth, g.life.survive)) else None
        Table(_) | Wolfram(_) -> None

// The counts a mask holds, as the digits B/S notation writes them in.
private counts(mask: u16) -> string
    var out = ""

    for n in 0..9
        if (mask >> n) & 1 == 1 then out = s"${out}${n}"

    out

// Read a rule in B/S or Hensel notation.
//
// Three spellings are accepted, because all three are in circulation in pattern files:
//
//   - `B3/S23`, births first, which is what Golly and LifeWiki write;
//   - `S23/B3`, the same two halves the other way round;
//   - `23/3`, survivals then births with no letters, the older notation many RLE files still carry.
//
// Each half is a run of distinct digits from 0 to 8 and may be empty (`B2/S` is Seeds). **A digit may
// be followed by Hensel letters** (`B2a`), or by `-` and letters (`B2-a`), naming which arrangements
// of that many neighbours it means; see `hensel.sysl`. Letters, `B` and `S` may be either case, as
// Golly reads them. A rule with no letters anywhere is a B/S rule; one with any is isotropic, even
// when its letters add up to whole counts.
//
// **A third part makes it a Generations rule**: the number of states, from 2 to 256, after `/C` when
// the halves are lettered (`B2/S/C3`, `S345/B2/C4`) and after a bare `/` when they are not (`/2/3`,
// `345/2/4`, MCell's survivals, births, states). Hensel letters may narrow its counts as anywhere else
// (`B2-a/S12/C5`). **`W` and a number from 0 to 255 is a Wolfram code** (`W110`).
//
// Anything else is refused with a diagnostic pointing at the byte that broke it.
parse_rule(text: string) -> Result[Rule, Diagnostic]
    var s = scanner_of(text)

    s.skip_blanks()

    if s.at_end() then return Err(error(s.here(), "a rule is needed, such as B3/S23"))

    val first = s.peek().unwrap()
    var birth = Half(0, false)
    var survive = Half(0, false)
    // Whether the halves were introduced by `B` and `S`, so that a count of states is introduced by `C`.
    var named = true

    if first == u8('W') || first == u8('w')
        s.bump()
        return wolfram(&s)

    if first == u8('B') || first == u8('b')
        s.bump()
        birth = read_half(&s)?
        expect_half(&s, u8('S'))?
        survive = read_half(&s)?
    elif first == u8('S') || first == u8('s')
        s.bump()
        survive = read_half(&s)?
        expect_half(&s, u8('B'))?
        birth = read_half(&s)?
    elif first.is_digit() || first == u8('/')
        named = false
        survive = read_half(&s)?

        if !s.accept(u8('/')) then return Err(error(s.here(), "expected `/` between the survival and birth counts"))

        birth = read_half(&s)?
    else
        return Err(error(Span(s.offset, s.offset + 1), "expected a rule such as B3/S23"))

    var states = 0

    if s.accept(u8('/'))
        if named && !s.accept(u8('C')) && !s.accept(u8('c'))
            return Err(error(s.here(), "expected `C` and the number of states after the `/`"))

        states = read_states(&s)?

    end_of_rule(&s)?

    val lettered = birth.lettered || survive.lettered

    if states > 0 then return Ok(Generations(GenerationsRule(hensel(birth.set, survive.set), lettered, states)))

    if lettered then return Ok(Isotropic(hensel(birth.set, survive.set)))

    Ok(LifeLike(counts_of(birth.set), counts_of(survive.set)))
end parse_rule

// Blanks, then nothing.
private end_of_rule(s: *Scanner) -> Result[unit, Diagnostic]
    s.skip_blanks()

    if !s.at_end() then return Err(error(Span(s.offset, s.src.len), "unexpected text after the rule"))

    Ok(())

// A Generations rule's number of states: at least 2, dead and alive, and at most 256, as Golly allows.
private read_states(s: *Scanner) -> Result[int, Diagnostic]
    val m = s.mark()

    if !s.peek().unwrap_or(0).is_digit() then return Err(error(s.here(), "expected the number of states, such as 3"))

    val n = read_digits(s, 10).unwrap_or(1000)

    if n < 2 then return Err(error(s.span_from(m), "a Generations rule has at least 2 states, dead and alive"))

    if n > 256 then return Err(error(s.span_from(m), "a Generations rule has at most 256 states"))

    Ok(int(n))

// The number after `W`: a byte, whose bit `4l + 2c + r` is what a cell becomes when it is `c` and its
// west and east neighbours are `l` and `r`.
private wolfram(s: *Scanner) -> Result[Rule, Diagnostic]
    val m = s.mark()

    if !s.peek().unwrap_or(0).is_digit() then return Err(error(s.here(), "expected the rule's number after `W`, such as W110"))

    val n = read_digits(s, 10).unwrap_or(1000)

    if n > 255 then return Err(error(s.span_from(m), "a Wolfram code is a number from 0 to 255"))

    end_of_rule(s)?

    Ok(Wolfram(u8(n)))

// One half of a rule as read: the arrangements it names, and whether any count carried letters.
private struct Half
    set: u64
    lettered: bool

// The `/` and the letter that open a rule's second half.
private expect_half(s: *Scanner, letter: u8) -> Result[unit, Diagnostic]
    if !s.accept(u8('/')) then return Err(error(s.here(), "expected `/` between the two halves of the rule"))

    val lower = letter + 32

    if !s.accept(letter) && !s.accept(lower)
        return Err(error(s.here(), s"expected `${str_of(letter)}` after the `/`"))

    Ok(())

// One half of a rule: a run of distinct neighbour counts, each with the letters that narrow it.
private read_half(s: *Scanner) -> Result[Half, Diagnostic]
    var seen: u16 = 0
    var half = Half(0, false)

    loop
        s.peek() match
            Some(c) ->
                val at = Span(s.offset, s.offset + 1)

                if c.is_digit()
                    val n = c - u8('0')

                    if n > 8 then return Err(error(at, s"a cell has 8 neighbours, so ${n} cannot be a count"))

                    if (seen >> n) & 1 == 1 then return Err(error(at, s"the count ${n} appears twice"))

                    seen |= u16(1) << n
                    s.bump()

                    val (set, lettered) = read_letters(s, int(n))?

                    half = Half(half.set | set, half.lettered || lettered)
                elif c == u8('-') || letter_index(lower(c)) >= 0
                    return Err(error(at, "a letter or `-` must follow the count whose arrangements it names"))
                else
                    break
            None -> break

    Ok(half)
end read_half

// The arrangements of `n` neighbours that the letters after the count name — every one when there
// are none — and whether there were any.
private read_letters(s: *Scanner, n: int) -> Result[(u64, bool), Diagnostic]
    val k = letters[n]
    val minus = s.offset
    val negated = s.accept(u8('-'))
    var named: u64 = 0

    loop
        val c = lower(s.peek().unwrap_or(0))
        val i = letter_index(c)

        if i < 0 then break

        val at = Span(s.offset, s.offset + 1)

        if k == 0 then return Err(error(at, s"${n} neighbours have only one arrangement, so ${n} takes no letters"))

        if i >= k then return Err(error(at, s"`${char(c)}` is not an arrangement of ${n} neighbours, which are ${spelled(n)}"))

        if (named >> u64(i)) & 1 == 1 then return Err(error(at, s"`${char(c)}` appears twice after ${n}"))

        named |= u64(1) << u64(i)
        s.bump()

    if negated && named == 0 then return Err(error(Span(minus, minus + 1), "a `-` must be followed by the letters it takes away"))

    val all = all_of(n)

    if named == 0 then return Ok((all, false))

    val set = named << u64(firsts[n])

    Ok((if negated then all & ~set else set, true))
end read_letters

// The letters a count takes, for a diagnostic: `c, e, a, i, k, n`.
private spelled(n: int) -> string
    var out = ""

    for i in 0..<letters[n]
        out = if i == 0 then str_of(ORDER[i]) else s"${out}, ${str_of(ORDER[i])}"

    out

private lower(c: u8) -> u8 = if c >= u8('A') && c <= u8('Z') then c + 32 else c

private str_of(c: u8) -> string = s"${char(c)}"
