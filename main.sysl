// Cellular automata: a bit-packed grid, any B/S, isotropic non-totalistic, Generations or Larger
// than Life rule, Wolfram's elementary rules, MCell's cyclic, Vote for Life, Weighted Life,
// Margolus, 1-D binary and 1-D totalistic rules, Golly rule tables, HashLife, RLE, MCell and Golly
// macrocell patterns, and a syslUI viewer.
//
//     automata [--rule <B…/S… | B…/S…/C… | W… | R…/T…/C…/N… | MS,D… | R…,W… | R…,C…,M…,S…,B…>
//              | --rule <name> | --rule-file <file.rule>] [--rules-dir <dir>]
//              [--pattern <1-8 | file.rle | file.mcl | file.mc>]
//              [--size <w>x<h>] [--torus | --bounded] [--hashlife] [--step <j>]
//     automata --shot <png> [--generations <n>] [same options]
//
// A B/S or isotropic rule without B0 runs on an unbounded plane unless `--torus` or `--bounded` asks
// for a grid; every other rule runs on the grid, a torus unless `--bounded`. `--size` is the grid's
// size, and on the plane the size of the region the first view shows.
//
// `--hashlife` runs the plane under HashLife, each step 2^`j` generations by `--step` (0 unless
// given); a Golly macrocell file (`.mc`) always runs under it. `--generations` counts steps then. A
// rule the plane cannot run — a rule table, Generations, MCell's radius-1 families — runs under the
// generic, multi-state HashLife instead, on an unbounded universe, unless `--torus` or `--bounded` asked
// for the grid.
//
// `--shot` draws one frame with no window at all, after running the pattern for a fixed number of
// generations, and writes it to a PNG: syslUI rasterizes into a PlutoVG surface either way, and the
// surface can write itself out, so the frame a person would see is one a machine can check.

import sh.sysl.ui.{Rect, render, pluto_canvas, fraction}
import sh.sysl.ui_sdl.{app, run, system_font}
import sh.sysl.plutovg
import sh.sysl.parsing.{Span, error, source_of}
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.text.parse_int

const WIDTH: int = 960
const HEIGHT: int = 720

// What the command line asked for.
struct Options
    rule: string
    rule_file: string
    rules_dir: string
    pattern: string
    width: int
    height: int
    edges: Edges
    shot: string
    generations: int
    // Whether `--size` and `--torus` or `--bounded` were given, which an MCell file's `#BOARD` and `#WRAP` give way to.
    sized: bool
    edged: bool
    // Whether HashLife runs the plane, and its step: 2^`step` generations.
    hashlife: bool
    step: int

main(args: []string) -> Result[unit, string]
    val o = options(args)?
    val m = model_of(o, args[0])?

    if o.shot == ""
        return run(app("automata", () -> screen(m), () -> GROUND, WIDTH, HEIGHT,
                       on_event = e -> shortcut(m, e), on_frame = dt -> tick(m, dt)))

    m.advance(o.generations)

    val font = system_font()

    if font == "" then return Err("no font this program knows about is on this machine")

    val surf = plutovg.surface(WIDTH, HEIGHT).expect("a drawing surface")
    val vg = plutovg.canvas(surf).expect("a drawing canvas")
    val face = plutovg.font(font).expect(s"the font at ${font} opened")
    var c = pluto_canvas(vg, face, 15.0)

    surf.clear(fraction(GROUND, 16), fraction(GROUND, 8), fraction(GROUND, 0))
    render(screen(m), &c, Rect(0, 0, WIDTH, HEIGHT))

    if !surf.write_png(o.shot) then return Err(s"${o.shot} could not be written")

    print(s"wrote ${o.shot}: ${status(m)}")
    Ok(())
end main

// The model the command line asks for, running under HashLife if `--hashlife` said so or the pattern is
// a macrocell file. `program` is the path the program was run by, which rule files are looked for
// beside.
model_of(o: Options, program: string) -> Result[&Model, string]
    val m = if o.pattern.ends_with(".mc") then macrocell_model(o, program)? else pattern_model(o, program)?

    m.step_log = o.step

    if o.hashlife && !m.hashlife
        // A rule the plane cannot run goes from the grid to the generic HashLife, unless the grid was
        // asked for.
        if !m.on_plane && (o.edged || plane_runs(m.rule)) then return Err("--hashlife runs on the unbounded plane, and this starts on a grid")

        if !m.on_plane
            if any_hashlife_refusal(m.rule) is Some(why) then return Err(s"--hashlife: ${why}")

            val name = m.message.read()

            m.to_hashed()
            m.message.set(name)
        else
            m.hashlife = true
            m.replant()

    Ok(m)

// The model for an RLE or MCell pattern, or a bundled one.
private pattern_model(given: Options, program: string) -> Result[&Model, string]
    var o = given
    val p = pattern_of(o.pattern)?

    if p.board is Some((w, h))
        if !o.sized
            o.width = w
            o.height = h

    if !o.edged && p.wrap == Some(false) then o.edges = Bounded

    val rule = if o.rule_file == "" then chosen_rule(o.rule, p, rule_dirs(o.rules_dir, program))? else rule_file(o.rule_file, o.rule, p)?
    val m = model(grid(o.width, o.height, o.edges), rule)

    m.start(p, starts_on_plane(o, p, rule))
    m.message.set(p.name)
    Ok(m)

// The model for a Golly macrocell file: its universe under HashLife, on the plane, under its own rule
// or the one `--rule` gives.
private macrocell_model(o: Options, program: string) -> Result[&Model, string]
    if o.edged then return Err("a macrocell file is an unbounded universe: --torus and --bounded do not apply")

    val text = read_text(o.pattern).map_err(e -> s"${o.pattern}: ${e}")?

    if is_multi_mc(text) then return multi_macrocell_model(o, text, rule_dirs(o.rules_dir, program))

    if o.rule_file != "" then return Err("a two-state macrocell file runs under HashLife, which takes a B/S or isotropic rule, not a rule file")

    var u = parse_mc(text).map_err(d -> s"${o.pattern} is not a macrocell file this can read\n${d.render(source_of(o.pattern, text))}")?

    if o.rule != ""
        u.rule = parse_rule(o.rule).map_err(d -> s"--rule could not be read\n${d.render(source_of("--rule", o.rule))}")?

        if hashlife_refusal(u.rule) is Some(why) then return Err(s"--rule: ${why}")

    val m = model(grid(o.width, o.height, Torus), u.rule)

    m.start_universe(u)
    m.message.set(o.pattern)
    // The first frame fits the universe, which may lie anywhere.
    m.placed = true
    m.fitting = true
    Ok(m)

// The model for a multi-state macrocell file: its universe under the generic HashLife, under the rule
// its `#R` line names, read as `--rule` reads one, or the one `--rule` or `--rule-file` gives.
private multi_macrocell_model(o: Options, text: string, dirs: Buf[string]) -> Result[&Model, string]
    var u = parse_multi_mc(text, name -> rule_named(name, dirs)).map_err(d -> s"${o.pattern} is not a macrocell file this can read\n${d.render(source_of(o.pattern, text))}")?

    if o.rule != "" && o.rule_file != "" then return Err("--rule and --rule-file both give the rule; give one")

    if o.rule != "" || o.rule_file != ""
        val rule = if o.rule != "" then rule_named(o.rule, dirs).map_err(why -> s"--rule: ${why}")? else Table(parse_rule_file(read_text(o.rule_file).map_err(e -> s"${o.rule_file}: ${e}")?).map_err(d -> s"${o.rule_file} is not a rule file this can read: ${d.message}")?)

        if multi_refusal(rule) is Some(why) then return Err(s"--rule: ${why}")

        if int(u.most_state()) >= rule.states()
            return Err(s"the universe has cells in state ${u.most_state()}, and ${rule.notation()}'s states are 0 to ${rule.states() - 1}")

        u.use_rule(rule)

    val m = model(grid(o.width, o.height, Torus), u.rule)

    m.start_hashed(u)
    m.message.set(o.pattern)
    // The first frame fits the universe, which may lie anywhere.
    m.placed = true
    m.fitting = true
    Ok(m)

// The rule `name` gives: a notation, or else the rule file `<name>.rule` in `dirs`.
private rule_named(name: string, dirs: Buf[string]) -> Result[Rule, string]
    parse_rule(name) match
        Ok(r) -> return Ok(r)
        Err(d) -> if !names_a_rule(name) then return Err(s"`${name}` is not a rule: ${d.message}")

    find_rule(name, dirs)? match
        Some(t) -> Ok(Table(t))
        None -> Err(s"the rule is `${name}`, which is ${not_found(name, dirs)}")

// Whether to start on the unbounded plane: under a rule that can run there, unless `--torus` or
// `--bounded` asked for a grid, or an MCell file's `#WRAP` said whether its board wraps.
starts_on_plane(o: Options, p: Pattern, rule: Rule) -> bool = !o.edged && p.wrap.is_none() && plane_runs(rule)

// The rule to start under: the one given with `--rule` if there was one, else the pattern's own, else
// Life. A rule that is not a notation is a name, and comes from `<name>.rule` in `dirs`. A `--rule`
// that is neither is refused with the diagnostic drawn under the text, and so is one with cells in
// states the rule does not have.
chosen_rule(given: string, p: Pattern, dirs: Buf[string] = buf()) -> Result[Rule, string]
    var rule = p.rule.unwrap_or(LifeLike(0b1000, 0b1100))

    if given != ""
        parse_rule(given) match
            Ok(r) -> rule = r
            Err(d) ->
                if !names_a_rule(given) then return Err(s"--rule could not be read\n${d.render(source_of("--rule", given))}")

                find_rule(given, dirs)? match
                    Some(t) -> return table_rule(t, p)
                    None -> return Err(s"--rule could not be read\n${error(Span(0, given.len), not_found(given, dirs)).render(source_of("--rule", given))}")
    elif p.rule.is_none() && p.rule_name != ""
        find_rule(p.rule_name, dirs)? match
            Some(t) -> return table_rule(t, p)
            None -> return Err(s"the pattern's rule is `${p.rule_name}`, which is ${not_found(p.rule_name, dirs)}")

    if rule.states() > 2 && int(p.most_state()) >= rule.states()
        return Err(s"the pattern has cells in state ${p.most_state()}, and ${rule.notation()}'s states are 0 to ${rule.states() - 1}")

    Ok(rule)

// The rule table in the file at `file`, which must have every state the pattern uses.
rule_file(file: string, given: string, p: Pattern) -> Result[Rule, string]
    if given != "" then return Err("--rule and --rule-file both give the rule; give one")

    val text = read_text(file).map_err(e -> s"${file}: ${e}")?
    val t = parse_rule_file(text).map_err(d -> s"${file} is not a rule file this can read\n${d.render(source_of(file, text))}")?

    table_rule(t, p)

// The rule table `t`, which must have every state the pattern uses.
private table_rule(t: RuleTable, p: Pattern) -> Result[Rule, string]
    if int(p.most_state()) >= t.states
        return Err(s"the pattern has cells in state ${p.most_state()}, and ${t.name}'s states are 0 to ${t.states - 1}")

    Ok(Table(t))

options(args: []string) -> Result[Options, string]
    var o = Options("", "", "", "4", 192, 144, Torus, "", 100, false, false, false, 0)
    var i = 1

    while i < args.len
        val flag = args[i]

        if flag == "--hashlife"
            o.hashlife = true
            i += 1
            continue

        if flag == "--torus" || flag == "--bounded"
            val edges = if flag == "--torus" then Torus else Bounded

            if o.edged && o.edges != edges then return Err("--torus and --bounded both give the edges; give one")

            o.edges = edges
            o.edged = true
            i += 1
            continue

        if i + 1 >= args.len then return Err(s"${flag} needs a value")

        val value = args[i + 1]

        if flag == "--rule"
            o.rule = value
        elif flag == "--rule-file"
            o.rule_file = value
        elif flag == "--rules-dir"
            o.rules_dir = value
        elif flag == "--pattern"
            o.pattern = value
        elif flag == "--shot"
            o.shot = value
        elif flag == "--generations"
            o.generations = parse_int(value).map_err(e -> s"--generations: `${value}` is not a number")?
        elif flag == "--step"
            o.step = parse_int(value).map_err(e -> s"--step: `${value}` is not a number")?

            if o.step < 0 || o.step > MOST_JUMP then return Err(s"--step: a step is 2^0 to 2^${MOST_JUMP} generations, given as 0 to ${MOST_JUMP}")
        elif flag == "--size"
            val (w, h) = size_of(value).ok_or(s"--size: expected <width>x<height>, such as 256x192")?

            o.width = w
            o.height = h
            o.sized = true
        else
            return Err(s"unknown option ${flag}")

        i += 2

    Ok(o)
end options

private size_of(text: string) -> Option[(int, int)]
    val at = text.index_of("x")?
    val w = parse_int(text[0..<at]).ok()?
    val h = parse_int(text[at + 1..<text.len]).ok()?

    if w < 1 || h < 1 || w > 8192 || h > 8192 then None else Some((w, h))

// A bundled pattern by its number, or an RLE or MCell file by its path.
private pattern_of(which: string) -> Result[Pattern, string]
    val patterns = bundled()

    parse_int(which) match
        Ok(n) ->
            if n < 1 || n > int(patterns.len) then return Err(s"--pattern: there are ${patterns.len} bundled patterns")

            return Ok(parse_rle(patterns[usize(n - 1)]).unwrap())
        Err(_) -> ()

    val text = read_text(which).map_err(e -> s"${which}: ${e}")?
    val read = if text.trim().starts_with("#MCell") then parse_mcl(text) else parse_rle(text)

    read.map_err(d -> s"${which} is not a pattern this can read\n${d.render(source_of(which, text))}")
