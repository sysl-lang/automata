// A grid, packed one cell per bit, stepped a whole machine word at a time under a two-state rule.
//
// **Cell `x` of a row is bit `x % 64` of word `x / 64`**, and a row is as many words as its width
// needs. The bits past the width in a row's last word are always zero: every step masks them off, and
// every count and comparison may rely on it.
//
// **A step never looks at one cell.** The eight neighbours of all 64 cells in a word are eight words —
// the rows above and below and the row itself, each shifted one place either way — and those are
// summed by bit-sliced addition into four words holding a 4-bit count per cell. Comparing that count
// against the rule's births and survivals is a handful of ANDs per count, so a word's 64 cells cost
// what one cell would cost done naively.
//
// **A rule table has more than two states, so beside the bits is a byte per cell.** The bits always
// say which cells are not in state 0, whatever the rule; the bytes hold each cell's state, and are
// only kept up while a table or a Generations rule is running or a cell has been set to a state
// above 1. A two-state step
// never touches them, and marks them stale instead.

import sysl.buf.{Buf, buf_filled}
import sysl.math.min
import sysl.rand.Rng

// What lies beyond the grid's edges.
enum Edges
    // The grid wraps: the column left of 0 is the last one, the row above 0 is the last one.
    Torus
    // The grid is surrounded by cells that are dead and stay dead.
    Bounded

struct Grid
    width: int
    height: int
    edges: Edges
    // Words per row.
    stride: int
    cells: Buf[u64]
    // The other generation, written by `step` and then swapped in.
    spare: Buf[u64]
    // Each cell's state, row by row, a byte apiece, and the other generation of them.
    states: Buf[u8]
    spare_states: Buf[u8]
    // Whether `states` holds every cell's state. When it does not, a cell's state is its bit.
    fresh: bool
    // Under a Wolfram rule, the row holding the line's latest generation; -1 until a step finds it.
    front: int
    // Under a Margolus rule, which partition the next step cuts the grid into: 0 puts the blocks'
    // corners on even coordinates, 1 on odd ones. Each step flips it.
    phase: int

    // Is the cell at `x`, `y` alive — in any state but 0? Coordinates outside the grid wrap on a
    // torus and are dead when bounded.
    get(self, x: int, y: int) -> bool
        self.inside(x, y) match
            Some((cx, cy)) -> (self.cells[self.word_at(cx / 64, cy)] >> u64(cx % 64)) & 1 == 1
            None -> false

    // Set the cell at `x`, `y`, wrapping on a torus and ignoring a cell outside a bounded grid.
    set(*self, x: int, y: int, alive: bool)
        self.inside(x, y) match
            Some((cx, cy)) ->
                val i = self.word_at(cx / 64, cy)
                val bit = u64(1) << u64(cx % 64)

                self.cells[i] = if alive then self.cells[i] | bit else self.cells[i] & ~bit
                self.front = -1

                if self.fresh then self.states[self.byte_at(cx, cy)] = if alive then 1 else 0
            None -> ()

    // The state of the cell at `x`, `y`, the coordinates resolved as `get` resolves them.
    state(self, x: int, y: int) -> u8
        self.inside(x, y) match
            Some((cx, cy)) ->
                if self.fresh then self.states[self.byte_at(cx, cy)] elif self.get(cx, cy) then 1 else 0
            None -> 0

    // Put the cell at `x`, `y` in `state`, the coordinates resolved as `set` resolves them.
    set_state(*self, x: int, y: int, state: u8)
        self.inside(x, y) match
            Some((cx, cy)) ->
                self.keep_states()
                self.set(cx, cy, state != 0)
                self.states[self.byte_at(cx, cy)] = state
            None -> ()

    toggle(*self, x: int, y: int) = self.set(x, y, !self.get(x, y))

    clear(*self)
        for i in 0..<self.cells.len()
            self.cells[i] = 0

        self.fresh = false
        self.front = -1
        self.phase = 0

    // How many cells are alive.
    population(self) -> int
        var n = 0

        for i in 0..<self.cells.len()
            n += int(self.cells[i].count_ones())

        n

    // Every cell alive with probability `percent` in a hundred.
    randomize(*self, g: *Rng, percent: int)
        self.clear()

        for y in 0..<self.height
            for x in 0..<self.width
                if int(g.below(100)) < percent then self.set(x, y, true)

    // Every cell in one of the states `0..<states`, each as likely as the rest: the soup a cyclic rule
    // starts from.
    randomize_states(*self, g: *Rng, states: int)
        self.clear()

        for y in 0..<self.height
            for x in 0..<self.width
                self.set_state(x, y, u8(g.below(u64(states))))

    // Do the two grids hold the same cells? Their shapes must agree as well.
    same_cells(self, other: Grid) -> bool
        if self.width != other.width || self.height != other.height then return false

        for i in 0..<self.cells.len()
            if self.cells[i] != other.cells[i] then return false

        if !self.fresh && !other.fresh then return true

        for y in 0..<self.height
            for x in 0..<self.width
                if self.state(x, y) != other.state(x, y) then return false

        true

    // Advance one generation under `rule`.
    step(*self, rule: Rule)
        // A Wolfram rule's latest row is looked for again once another rule has run.
        if rule is Wolfram(code)
            self.step_wolfram(code)
            self.fresh = false
            return

        self.front = -1

        rule match
            LifeLike(b, s) ->
                self.step_life_like(b, s)
                self.fresh = false
            Isotropic(h) ->
                self.step_isotropic(h)
                self.fresh = false
            Table(t) -> self.step_table(t)
            Generations(g) -> self.step_generations(g)
            LargerThanLife(l) ->
                self.keep_states()
                l.step(self.states, self.spare_states, self.width, self.height, self.edges == Torus)
                self.swap_states()
            Vote(counts) ->
                val (b, s) = vote_life(counts)

                self.step_life_like(b, s)
                self.fresh = false
            Cyclic(c) ->
                self.keep_states()
                c.step(self.states, self.spare_states, self.width, self.height, self.edges == Torus)
                self.swap_states()
            Weighted(w) ->
                self.keep_states()
                w.step(self.states, self.spare_states, self.width, self.height, self.edges == Torus)
                self.swap_states()
            Margolus(m) ->
                self.keep_states()
                m.step(self.states, self.spare_states, self.width, self.height, self.edges == Torus, self.phase)
                self.swap_states()
                self.phase = 1 - self.phase
            Wolfram(_) -> ()

    // One generation under a rule table: a cell's state and its neighbours' make an index, and the
    // table holds what the cell becomes there. Then the bits are brought into line with the bytes.
    private step_table(*self, t: &RuleTable)
        self.keep_states()

        val ring = t.neighbourhood.ring()
        val order = t.neighbourhood.tree_order()
        val n = t.states

        for y in 0..<self.height
            for x in 0..<self.width
                val at = self.byte_at(x, y)

                if t.next.len() == 0
                    // A tree too large to expand: walk it, a neighbour at a time in its own order.
                    var node = t.root

                    for i in 0..<order.len
                        val (dx, dy) = ring[usize(order[i])]

                        node = t.tree[usize(node + int(self.state(x + dx, y + dy)))]

                    self.spare_states[at] = u8(t.tree[usize(node + int(self.states[at]))])
                    continue

                var index = int(self.states[at])
                var weight = n

                for i in 0..<ring.len
                    val (dx, dy) = ring[i]

                    index += weight * int(self.state(x + dx, y + dy))
                    weight *= n

                self.spare_states[at] = t.next[usize(index)]

        self.swap_states()
    end step_table

    // Make the generation just written to `spare_states` the current one, and bring the bits into line
    // with it.
    private swap_states(*self)
        val done = self.states

        self.states = self.spare_states
        self.spare_states = done

        for y in 0..<self.height
            for k in 0..<self.stride
                var word: u64 = 0

                for b in 0..<min(64, self.width - k * 64)
                    if self.states[self.byte_at(k * 64 + b, y)] != 0 then word |= u64(1) << u64(b)

                self.cells[self.word_at(k, y)] = word
    end swap_states

    // Make `states` hold every cell's state, from the bits if it has gone stale.
    private keep_states(*self)
        if self.fresh then return

        for y in 0..<self.height
            for x in 0..<self.width
                self.states[self.byte_at(x, y)] = if self.get(x, y) then 1 else 0

        self.fresh = true

    private step_life_like(*self, birth: u16, survive: u16)
        val tail = self.tail_mask()

        for y in 0..<self.height
            for k in 0..<self.stride
                var next = self.life_word(y, k, birth, survive)

                if k == self.stride - 1 then next &= tail

                self.spare[self.word_at(k, y)] = next

        val done = self.cells

        self.cells = self.spare
        self.spare = done

    // What word `k` of row `y` becomes under a B/S rule, its tail bits unmasked.
    private life_word(self, y: int, k: int, birth: u16, survive: u16) -> u64 =
        life_bits(self.around(y, k), birth, survive)

    // The word's neighbourhood as `life_bits` and `isotropic_bits` take it: for the rows above, at
    // and below, the row's west neighbours, the row itself and its east neighbours.
    private around(self, y: int, k: int) -> [9]u64
        var w: [9]u64 = [0; 9]

        for dy in -1..1
            val row = y + dy
            val mid = self.row_word(row, k)
            val i = usize(3 * (dy + 1))

            w[i] = self.west(row, k, mid)
            w[i + 1] = mid
            w[i + 2] = self.east(row, k, mid)

        w

    // One generation under an isotropic rule, a cell at a time through the rule's table of answers.
    private step_isotropic(*self, h: Hensel)
        val tail = self.tail_mask()

        for y in 0..<self.height
            for k in 0..<self.stride
                var next = self.isotropic_word(y, k, h)

                if k == self.stride - 1 then next &= tail

                self.spare[self.word_at(k, y)] = next

        val done = self.cells

        self.cells = self.spare
        self.spare = done

    // What word `k` of row `y` becomes under an isotropic rule, its tail bits unmasked.
    private isotropic_word(self, y: int, k: int, h: Hensel) -> u64 = isotropic_bits(self.around(y, k), h)

    // One generation under a Generations rule.
    //
    // **Only state 1 is anyone's neighbour, so the neighbours are counted on a plane of state-1 bits**,
    // by the same word-at-a-time step a two-state rule runs, and its answer for each cell is whether
    // a dead cell is born or a live one survives. **The dying states are a byte per cell**: every
    // dying cell moves on every generation whatever its neighbours, so each needs its own write
    // anyway, and the bytes are what a table rule and the viewer already read. Then the bits are
    // brought back to saying which cells are not in state 0.
    private step_generations(*self, g: GenerationsRule)
        self.keep_states()

        for y in 0..<self.height
            for k in 0..<self.stride
                var live: u64 = 0

                for b in 0..<min(64, self.width - k * 64)
                    if self.states[self.byte_at(k * 64 + b, y)] == 1 then live |= u64(1) << u64(b)

                self.spare[self.word_at(k, y)] = live

        val occupied = self.cells

        self.cells = self.spare
        self.spare = occupied

        val (birth, survive) = (counts_of(g.life.birth), counts_of(g.life.survive))

        for y in 0..<self.height
            for k in 0..<self.stride
                val answer = if g.lettered then self.isotropic_word(y, k, g.life) else self.life_word(y, k, birth, survive)
                var next: u64 = 0

                for b in 0..<min(64, self.width - k * 64)
                    val at = self.byte_at(k * 64 + b, y)
                    val state = g.after(self.states[at], (answer >> u64(b)) & 1 == 1)

                    self.spare_states[at] = state

                    if state != 0 then next |= u64(1) << u64(b)

                self.spare[self.word_at(k, y)] = next

        val done = self.cells

        self.cells = self.spare
        self.spare = done

        val old = self.states

        self.states = self.spare_states
        self.spare_states = old
    end step_generations

    // One generation under a Wolfram rule: the row after the line's latest generation is written
    // from it, and every other row is left as it is. When the latest is the bottom row, the history
    // moves up a row first, so the oldest generation shown scrolls off the top.
    //
    // **The line is the row, and the grid's edges are its ends**: on a torus the line is a ring, and
    // bounded it is held between cells that are dead for ever. Above and below are only history, so
    // whether the grid wraps top to bottom does not matter here. Because a row is written only from
    // the one above it, an odd code — which turns a dead cell between dead neighbours on — is no
    // harder than an even one: the empty rows below are not stepped, so they cannot all fill.
    //
    // Before the first step the latest generation is the lowest row with a live cell in it, row 0 on
    // an empty grid.
    private step_wolfram(*self, code: u8)
        if self.front < 0
            self.front = 0

            for y in 0..<self.height
                for k in 0..<self.stride
                    if self.cells[self.word_at(k, y)] != 0 then self.front = y

        val tail = self.tail_mask()

        // The next generation, a word at a time into the first row of `spare`: a cell is on where the
        // code's bit for its west neighbour, itself and its east neighbour is.
        for k in 0..<self.stride
            val here = self.row_word(self.front, k)
            val west = self.west(self.front, k, here)
            val east = self.east(self.front, k, here)
            var next: u64 = 0

            for p in 0..<8
                if (code >> u8(p)) & 1 == 1 then next |= pick(west, p, 2) & pick(here, p, 1) & pick(east, p, 0)

            self.spare[usize(k)] = if k == self.stride - 1 then next & tail else next

        if self.front == self.height - 1
            for i in 0..<usize(self.stride * (self.height - 1))
                self.cells[i] = self.cells[i + usize(self.stride)]
        else
            self.front += 1

        for k in 0..<self.stride
            self.cells[self.word_at(k, self.front)] = self.spare[usize(k)]
    end step_wolfram

    // Word `k` of row `y`, with the row wrapped on a torus and an empty row beyond a bounded edge.
    private row_word(self, y: int, k: int) -> u64
        if y >= 0 && y < self.height then return self.cells[self.word_at(k, y)]

        self.edges match
            Torus -> self.cells[self.word_at(k, (y + self.height) % self.height)]
            Bounded -> 0

    // The row's west neighbours lined up under the cells they border: bit `i` is cell `i - 1`.
    private west(self, y: int, k: int, word: u64) -> u64
        var carry: u64 = 0

        if k > 0
            carry = self.row_word(y, k - 1) >> 63
        elif self.edges == Torus
            carry = self.row_bit(y, self.width - 1)

        (word << 1) | carry

    // The row's east neighbours: bit `i` is cell `i + 1`.
    private east(self, y: int, k: int, word: u64) -> u64
        var carry: u64 = 0

        if k < self.stride - 1
            carry = self.row_word(y, k + 1) << 63
        elif self.edges == Torus
            carry = self.row_bit(y, 0) << u64((self.width - 1) % 64)

        (word >> 1) | carry

    // Cell `x` of row `y` as a 0 or 1, the row resolved as `row_word` resolves it.
    private row_bit(self, y: int, x: int) -> u64 = (self.row_word(y, x / 64) >> u64(x % 64)) & 1

    // The bits of a row's last word that are cells.
    private tail_mask(self) -> u64
        val used = self.width - (self.stride - 1) * 64

        if used == 64 then ~u64(0) else (u64(1) << u64(used)) - 1

    private word_at(self, k: int, y: int) -> usize = usize(y * self.stride + k)

    private byte_at(self, x: int, y: int) -> usize = usize(y * self.width + x)

    // The cell `x`, `y` names, or nothing if it is off a bounded grid.
    private inside(self, x: int, y: int) -> Option[(int, int)]
        if x >= 0 && x < self.width && y >= 0 && y < self.height then return Some((x, y))

        self.edges match
            Torus -> Some((wrap(x, self.width), wrap(y, self.height)))
            Bounded -> None
end Grid

// An empty grid. Both sides must be at least 1.
grid(width: int, height: int, edges: Edges) -> Grid
    val stride = (width + 63) / 64
    val words = usize(stride * height)

    val cells = usize(width * height)

    Grid(width, height, edges, stride, buf_filled(words, 0), buf_filled(words, 0), buf_filled(cells, 0),
         buf_filled(cells, 0), false, -1, 0)

// `x` reduced into `0..<n`, for a negative `x` as well.
wrap(x: int, n: int) -> int = ((x % n) + n) % n

// What a word of 64 cells becomes under a B/S rule. `w` is the word's neighbourhood: for the rows
// above, at and below it, the row's west neighbours (bit `i` is cell `i - 1`), the row, and its east
// neighbours (bit `i` is cell `i + 1`). A grid and a plane tile each line those nine words up from
// their own storage; the step is the same.
life_bits(w: [9]u64, birth: u16, survive: u16) -> u64
    // Bit-sliced count of the eight neighbours: bit `i` of `c0..c3` is bit 0..3 of cell `i`'s count.
    var c0: u64 = 0
    var c1: u64 = 0
    var c2: u64 = 0
    var c3: u64 = 0

    for i in 0..<9
        if i != 4 then c0, c1, c2, c3 = add(c0, c1, c2, c3, w[usize(i)])

    // Which cells' counts are a birth count, and which a survival count.
    var born: u64 = 0
    var stays: u64 = 0

    for n in 0..9
        val b = (birth >> n) & 1 == 1
        val s = (survive >> n) & 1 == 1

        if b || s
            val is_n = pick(c0, n, 0) & pick(c1, n, 1) & pick(c2, n, 2) & pick(c3, n, 3)

            if b then born |= is_n

            if s then stays |= is_n

    val alive = w[4]

    (born & ~alive) | (stays & alive)
end life_bits

// What a word of 64 cells becomes under an isotropic rule, a cell at a time through the rule's table,
// the neighbourhood `w` lined up as `life_bits` takes it. The index holds the columns west of, at and
// east of a cell: moving one cell east drops the west column and takes the next one in from the east
// words, whose bit `i` is cell `i + 1`.
isotropic_bits(w: [9]u64, h: Hensel) -> u64
    var en = w[2]
    var eh = w[5]
    var es = w[8]
    val west = (w[0] & 1) | ((w[3] & 1) << 1) | ((w[6] & 1) << 2)
    var index = int(west | ((w[1] & 1) << 3) | ((w[4] & 1) << 4) | ((w[7] & 1) << 5))
    var next: u64 = 0

    for i in 0..<64
        index |= int((en & 1) << 6) | int((eh & 1) << 7) | int((es & 1) << 8)
        next |= u64(h.answers[usize(index)]) << u64(i)
        index >>= 3
        en >>= 1
        eh >>= 1
        es >>= 1

    next
end isotropic_bits

// One more bit added into a bit-sliced 4-bit counter, 64 lanes at once.
private add(c0: u64, c1: u64, c2: u64, c3: u64, x: u64) -> (u64, u64, u64, u64)
    val k1 = c0 & x
    val k2 = c1 & k1
    val k3 = c2 & k2

    (c0 ^ x, c1 ^ k1, c2 ^ k2, c3 | k3)

// The lanes whose count has bit `bit` equal to that bit of `n`.
private pick(c: u64, n: int, bit: int) -> u64 = if (n >> bit) & 1 == 1 then c else ~c
