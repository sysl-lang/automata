// The viewer: the grid drawn as a pannable, zoomable board, a status line, and a field a rule is typed
// into.
//
// **The board is one view that paints the cells itself.** A view per cell would be a tree of tens of
// thousands of boxes rebuilt every generation; a single view that knows the grid draws each row's runs
// of live cells as one rectangle apiece, and asks the canvas for the pointer's drag, wheel and taps
// while it paints, which is the only moment it knows where it is.

import sh.sysl.ui.{View, Canvas, Size, Rect, Signal, signal, column, row, text, button, text_field,
                   spacer, NOBODY}
import sh.sysl.ui_sdl.stop
import sh.sysl.sdl3.{Event, EventKind, SCANCODE_ESCAPE, SCANCODE_SPACE, SCANCODE_N, SCANCODE_R,
                     SCANCODE_C, SCANCODE_T, SCANCODE_F, SCANCODE_0, SCANCODE_1, SCANCODE_EQUALS, SCANCODE_MINUS,
                     SCANCODE_KP_PLUS, SCANCODE_KP_MINUS, SCANCODE_RETURN, SCANCODE_KP_ENTER, SCANCODE_H,
                     SCANCODE_LEFTBRACKET, SCANCODE_RIGHTBRACKET}
import sysl.buf.{Buf, buf}
import sysl.math.{Float, clamp, max, min}
import sysl.rand.{Rng, rng}

// Generations per second, slowest first; `+` and `-` move along it.
val SPEEDS = [1, 2, 5, 10, 20, 30, 60, 120, 240, 480]

// At most this many generations are run in one frame, so a slow machine falls behind rather than
// stalling.
const MOST_PER_FRAME: int = 32

const GROUND: u32 = 0x12141C
const BOARD: u32 = 0x0B0C10
const LIVE: u32 = 0x8BD3A8
const EDGE: u32 = 0x3A4050

// The id the rule field takes the keyboard under.
const RULE_FIELD: int = 1

// Everything the viewer knows. The grid and the camera are plain fields, written in place; what the
// tree is built from is in signals, so writing one rebuilds the status line on the same frame.
struct Model
    grid: Grid
    // The unbounded plane, and whether it is what runs. While it is, the grid keeps only its size: the
    // region the first view shows, and the one the plane is copied into when the view leaves it.
    plane: Plane
    on_plane: bool
    rule: Rule
    running: bool
    speed: int
    // Points per cell, and where cell (0, 0)'s corner is, relative to the board's own corner. On the
    // plane it is cell (`cx`, `cy`)'s corner instead, and whole cells of the offset are moved into
    // those, so the offsets stay within a cell however far the view travels.
    zoom: real
    ox: real
    oy: real
    cx: i64
    cy: i64
    placed: bool
    // Whether the next frame fits the view to the pattern.
    fitting: bool
    // Fractions of a generation owed, carried from frame to frame.
    owed: real
    // Whether a field has the keyboard, so typing a rule does not also drive the shortcuts.
    typing: bool
    // Which of the patterns past the number keys' `0` loads next.
    more: int
    random: Rng
    generation: &Signal[i64]
    rule_text: &Signal[string]
    message: &Signal[string]
    // Whether HashLife runs the plane in place of the plane's own step. While it does, the universe
    // holds the cells, and the plane holds only those under the board, drawn onto it from the universe
    // when the board is painted: `window` is the cells it holds, west, north, across and down, and
    // `shown` says they are the universe's as it is now. A pattern or soup put on the plane replaces
    // the universe at once.
    hashlife: bool
    universe: Universe
    shown: bool
    window: (i64, i64, i64, i64)
    // Each step HashLife takes is 2^`step_log` generations.
    step_log: int
    // Whether the HashLife that runs is the generic one, for a rule the plane cannot run: `hashed` holds
    // the cells, the plane stays empty, and the board draws `sheet`, the window under it flattened into
    // a grid with every cell's state. The grid holds the cells while HashLife is off, and is where they
    // come from and go back to.
    multi: bool
    hashed: MultiUniverse
    sheet: Grid

    // Something the status line shows has changed.
    touched(*self) = self.generation.set(self.generation.read())

    // Is HashLife what runs?
    hashlife_on(self) -> bool = self.on_plane && self.hashlife

    // Is it the generic HashLife?
    multi_on(self) -> bool = self.hashlife_on() && self.multi

    // HashLife's population and box, whichever universe runs.
    hashed_population(self) -> i64 = if self.multi then self.hashed.population() else self.universe.population()

    hashed_bounds(self) -> Option[(i64, i64, i64, i64)] = if self.multi then self.hashed.bounds() else self.universe.bounds()

    advance(*self, n: int)
        if self.on_plane && self.hashlife
            self.advance_hashlife(n)
            return

        for i in 0..<n
            if self.on_plane then self.plane.step(self.rule) else self.grid.step(self.rule)

        self.generation.set(self.generation.read() + i64(n))

    // `n` steps, as `advance` takes them, but under HashLife as one jump for each binary digit of the
    // `n` · 2^`step_log` generations they make: a million steps of one generation are seven jumps, the
    // biggest 2^19, where `advance` takes a million steps. It is for one long run, such as the frames a
    // shot is drawn after. Each jump of another size forgets the results kept at the last one, so a
    // run made of many short calls is quicker through `advance`, whose steps are all one size.
    advance_at_once(*self, n: int)
        val generations = i64(n) << i64(self.step_log)

        if !self.on_plane || !self.hashlife || generations >> i64(MOST_STEP + 1) != 0
            self.advance(n)
            return

        if self.multi then self.hashed.advance(generations) else self.universe.advance(generations)

        self.shown = false
        self.generation.set(self.generation.read() + generations)

    // `n` of HashLife's steps.
    private advance_hashlife(*self, n: int)
        if self.multi
            self.hashed.set_step(self.step_log)

            for i in 0..<n
                self.hashed.step()
        else
            self.universe.set_step(self.step_log)

            for i in 0..<n
                self.universe.step()

        self.shown = false
        self.generation.set(self.generation.read() + (i64(n) << i64(self.step_log)))

    // Under HashLife, the universe made again from the plane, which has just been given a whole new
    // set of cells.
    replant(*self)
        if self.multi_on()
            self.hashed = multi_universe_of_grid(self.rule, self.grid, self.grid.width / 2, self.grid.height / 2).unwrap()
            self.shown = false
        elif self.on_plane && self.hashlife
            self.universe = universe_of_plane(self.rule, self.plane).unwrap()
            self.shown = false

    // Draw the universe's cells from `west`, `north`, `across` by `down`, onto the plane — or under the
    // generic HashLife onto the sheet — unless it already holds them.
    show(*self, west: i64, north: i64, across: i64, down: i64)
        if self.shown && self.window == (west, north, across, down) then return

        if self.multi
            if self.sheet.width != int(across) || self.sheet.height != int(down)
                self.sheet = grid(int(across), int(down), Bounded)
            else
                self.sheet.clear()

            self.hashed.window_into(&self.sheet, west, north)
        else
            self.plane.clear()
            self.universe.window_into(&self.plane, west, north, west + across - 1, north + down - 1)

        self.window = (west, north, across, down)
        self.shown = true

    // Start with `p`: at the plane's origin if `plane`, else centred on the grid.
    start(*self, p: Pattern, plane: bool)
        self.on_plane = plane

        if plane then p.stamp_origin(&self.plane) else p.stamp_centred(&self.grid)

        self.replant()

    // Start with the universe `u` under HashLife, at its own generation, on the plane.
    start_universe(*self, u: Universe)
        self.on_plane = true
        self.hashlife = true
        self.universe = u
        self.shown = false
        self.rule = u.rule
        self.rule_text.set(u.rule.notation())
        self.generation.set(u.generation)

    // Start with the multi-state universe `u` under the generic HashLife, at its own generation.
    start_hashed(*self, u: MultiUniverse)
        self.on_plane = true
        self.hashlife = true
        self.multi = true
        self.hashed = u
        self.shown = false
        self.plane.clear()
        self.rule = u.rule
        self.rule_text.set(u.rule.notation())
        self.generation.set(u.generation)

    // Move the grid's cells into the generic HashLife, the grid's centre on the origin and the view
    // where it was. The rule must be one `multi_refusal` takes.
    to_hashed(*self)
        self.on_plane = true
        self.hashlife = true
        self.multi = true
        self.plane.clear()
        self.replant()
        self.cx = -i64(self.grid.width / 2)
        self.cy = -i64(self.grid.height / 2)
        self.message.set(s"HashLife for every state: a step is 2^${self.step_log} generations")

    // Run the plane under HashLife, or under its own step, or say why HashLife cannot run. Off, every
    // cell goes back onto the plane, unless there are more than the plane should be asked to hold. A
    // rule the plane cannot run goes to the generic HashLife from the grid, and back onto a torus.
    use_hashlife(*self, on: bool)
        if !on
            if !self.hashlife_on() then return

            if self.multi
                self.to_grid(Torus)
                self.message.set(s"HashLife off: on a torus, ${self.grid.width}×${self.grid.height}")
                return

            if self.universe.population() > PLANE_MOST
                self.message.set(s"${self.universe.population()} cells are more than the plane holds: HashLife stays on")
                return

            self.plane.clear()
            self.universe.cells_into(&self.plane)
            self.hashlife = false
            self.message.set("HashLife off: the plane steps a generation at a time")
        elif !self.on_plane && !plane_runs(self.rule)
            if any_hashlife_refusal(self.rule) is Some(why) then self.message.set(why) else self.to_hashed()
        elif !self.on_plane
            self.message.set("HashLife runs on the unbounded plane: t moves onto it")
        else
            if hashlife_refusal(self.rule) is Some(why)
                self.message.set(why)
            else
                self.hashlife = true
                self.replant()
                self.message.set(s"HashLife: a step is 2^${self.step_log} generations")

    // Make HashLife's step 2^`j` generations, within 2^0 to 2^MOST_JUMP.
    step_size(*self, j: int)
        self.step_log = max(0, min(MOST_JUMP, j))
        self.message.set(s"HashLife's step is 2^${self.step_log} generations")

    // Run `text` as the rule, or say why it cannot be.
    use_rule(*self, text: string)
        parse_rule(text) match
            Ok(r) ->
                self.rule = r
                self.rule_text.set(r.notation())
                self.message.set(s"rule ${r.notation()}")
                self.leave_plane_for(r)

                if self.hashlife_on()
                    self.universe.use_rule(r)
                    self.shown = false
            Err(d) -> self.message.set(s"${d.message} (column ${d.span.start + 1} of \"${text}\")")

    // Replace the board with `p`, centred, under its own rule if it names one.
    load(*self, p: Pattern)
        if p.rule is Some(r) then self.leave_plane_for(r)

        if self.on_plane && !self.multi_on()
            self.plane.clear()
            p.stamp_origin(&self.plane)
        else
            self.grid.clear()
            p.stamp_centred(&self.grid)

        self.generation.set(0)

        if p.rule is Some(r)
            self.rule = r
            self.rule_text.set(r.notation())

        self.replant()
        self.message.set(if p.name != "" then p.name else "pattern loaded")

    // Every cell dead.
    clear(*self)
        if self.on_plane && !self.multi_on() then self.plane.clear() else self.grid.clear()

        self.generation.set(0)
        self.replant()

    // A random soup over the grid's region; on the plane, the region centred on the origin.
    randomize(*self)
        // A cyclic rule starts from every colour at once, as MCell's cyclic rules want.
        if self.rule is Cyclic(c) then self.grid.randomize_states(&self.random, c.states) else self.grid.randomize(&self.random, 30)

        if self.multi_on() then self.replant() elif self.on_plane then self.copy_to_plane()

        self.generation.set(0)

    // Flip the cell at `x`, `y` of the view's own coordinates: the grid's, or the plane's. Under the
    // generic HashLife a cell in any state goes to 0, and one in 0 to 1.
    toggle(*self, x: i64, y: i64)
        if self.multi_on()
            self.hashed.set(x, y, if self.hashed.get(x, y) == 0 then 1 else 0)
            self.shown = false
        elif self.hashlife_on()
            self.universe.set(x, y, !self.universe.get(x, y))
            self.shown = false
        elif self.on_plane
            self.plane.toggle(x, y)
        else
            self.grid.toggle(int(x), int(y))

        self.touched()

    // The next of the edges: the plane, then a torus, then dead edges, then the plane again — the
    // plane left out under a rule that cannot run on it.
    cycle_edges(*self)
        if self.on_plane
            self.to_grid(Torus)
        elif self.grid.edges == Torus
            self.grid.edges = Bounded
        elif plane_runs(self.rule)
            self.to_plane()
        else
            self.grid.edges = Torus

        self.touched()

    // Fit the view to the pattern on the next frame; on the grid, to the whole grid.
    fit(*self)
        if self.on_plane then self.fitting = true else self.placed = false

        self.touched()

    // Move onto the plane, the grid's centre on the origin and the view where it was.
    to_plane(*self)
        self.copy_to_plane()
        self.on_plane = true
        self.replant()
        self.cx = -i64(self.grid.width / 2)
        self.cy = -i64(self.grid.height / 2)

    // Move onto the grid with `edges`, the origin on the grid's centre and the view where it was. Cells
    // beyond the grid's region are dropped, and the message says how many.
    to_grid(*self, edges: Edges)
        val g = self.grid
        val left = i64(g.width / 2)
        val top = i64(g.height / 2)
        val before = if self.hashlife_on() then self.hashed_population() else i64(self.plane.population())

        // The generic HashLife's cells go straight onto the grid, each in its state.
        if self.multi_on()
            self.grid.clear()
            self.grid.edges = edges
            self.hashed.window_into(&self.grid, -left, -top)
            self.ox += real(-left - self.cx) * self.zoom
            self.oy += real(-top - self.cy) * self.zoom
            self.on_plane = false
            self.hashlife = false
            self.multi = false

            val dropped = before - i64(self.grid.population())

            if dropped > 0 then self.message.set(s"${dropped} cells beyond the ${g.width}×${g.height} grid were dropped")

            return

        // Under HashLife the plane holds only what was on the board: the grid's region is drawn onto it.
        if self.hashlife_on()
            self.plane.clear()
            self.universe.window_into(&self.plane, -left, -top, i64(g.width) - left - 1, i64(g.height) - top - 1)

        self.grid.clear()
        self.grid.edges = edges

        for y in 0..<g.height
            for x in 0..<g.width
                if self.plane.get(i64(x) - left, i64(y) - top) then self.grid.set(x, y, true)

        self.ox += real(-left - self.cx) * self.zoom
        self.oy += real(-top - self.cy) * self.zoom
        self.on_plane = false
        self.plane.clear()

        val dropped = before - i64(self.grid.population())

        if dropped > 0 then self.message.set(s"${dropped} cells beyond the ${g.width}×${g.height} grid were dropped")

    // Leave the plane for a torus if `rule` cannot run on it. The generic HashLife is left for any new
    // rule, whose states its cells may not have.
    private leave_plane_for(*self, rule: Rule)
        if self.multi_on()
            self.to_grid(Torus)
            self.message.set(s"${rule.notation()}: HashLife off, on a torus — h runs it under HashLife again")
        elif self.on_plane && !plane_runs(rule)
            self.to_grid(Torus)
            self.message.set(s"${rule.notation()} cannot run on the unbounded plane: on a torus instead")

    // The grid's cells onto the plane, its centre on the origin.
    private copy_to_plane(*self)
        val g = self.grid
        val left = i64(g.width / 2)
        val top = i64(g.height / 2)

        self.plane.clear()

        for y in 0..<g.height
            for x in 0..<g.width
                if g.get(x, y) then self.plane.set(i64(x) - left, i64(y) - top, true)

        self.replant()

    // Whole cells of the plane camera's offset moved into its corner cell, leaving each offset in
    // `(-zoom, 0]`.
    private settle(*self)
        val kx = (-self.ox / self.zoom).floor()
        val ky = (-self.oy / self.zoom).floor()

        self.cx += i64(kx)
        self.cy += i64(ky)
        self.ox += kx * self.zoom
        self.oy += ky * self.zoom
end Model

model(g: Grid, rule: Rule) -> &Model =
    Model(g, plane(), false, rule, false, 3, 4.0, 0.0, 0.0, 0, 0, false, false, 0.0, false, 0, rng(1, 1),
          signal(0), signal(rule.notation()), signal(""), false, universe(LifeLike(0b1000, 0b1100)).unwrap(), false,
          (0, 0, 0, 0), 0, false, multi_universe(LifeLike(0b1000, 0b1100)).unwrap(), grid(1, 1, Bounded))

// The whole window: the board, then the status line and the rule field under it.
screen(m: &Model) -> &View =
    column([
        board(m).flex(),
        row([
            text(status(m)),
            spacer(),
            text_field(m.rule_text, RULE_FIELD, 160, "B3/S23"),
            button("apply", () -> m.use_rule(m.rule_text.read())),
        ], 10).padding(8),
        text(if m.message.read() != "" then m.message.read() elif m.hashlife_on() then HASHLIFE_HINT
             elif m.on_plane then PLANE_HINT else HINT)
            .pad(left = 8, bottom = 8),
    ])

const HINT: string = "space run · n step · +/- speed · r random · c clear · t edges · 1-4 rules · 5-9, 0 patterns"
const PLANE_HINT: string = "space run · n step · +/- speed · r random · c clear · t edges · f fit · 1-4 rules · 5-9, 0 patterns"
const HASHLIFE_HINT: string = "space run · n step · +/- speed · [/] step size · h HashLife off · r random · c clear · t edges · f fit"

// The largest step `]` makes HashLife take: 2^40 generations.
const MOST_JUMP: int = 40

// The most cells HashLife hands back to the plane when it is turned off.
const PLANE_MOST: i64 = 1 << 22

// The status line. On the plane it gives the box the live cells lie in, as its size and its north-west
// cell, the origin being where the grid's centre was.
status(m: &Model) -> string
    val state = if m.running then s"${SPEEDS[m.speed]}/s" else "paused"

    if m.hashlife_on()
        val box = m.hashed_bounds() match
            Some((west, north, east, south)) -> s"${east - west + 1}×${south - north + 1} at ${west}, ${north}"
            None -> "empty"

        return s"gen ${m.generation.read()}   pop ${m.hashed_population()}   ${m.rule.notation()}   HashLife 2^${m.step_log}   box ${box}   ${state}"

    if m.on_plane
        val box = m.plane.bounds() match
            Some((west, north, east, south)) -> s"${east - west + 1}×${south - north + 1} at ${west}, ${north}"
            None -> "empty"

        return s"gen ${m.generation.read()}   pop ${m.plane.population()}   ${m.rule.notation()}   plane   box ${box}   ${state}"

    val edges = if m.grid.edges == Torus then "torus" else "bounded"

    s"gen ${m.generation.read()}   pop ${m.grid.population()}   ${m.rule.notation()}   ${edges}   ${state}"

private struct Board
    m: &Model

private board(m: &Model) -> &View = Board(m)

impl View for Board
    measure(&self, c: *Canvas, avail: Size) -> Size = avail

    paint(&self, c: *Canvas, r: Rect)
        val m = self.m
        val g = m.grid

        m.typing = c.focus() != NOBODY

        if m.on_plane
            paint_plane(m, c, r)
            return

        // The first frame fits the whole grid in the board and centres it.
        if !m.placed
            m.zoom = max(1.0, min(real(r.w) / real(g.width), real(r.h) / real(g.height)).floor())
            m.ox = (real(r.w) - m.zoom * real(g.width)) / 2.0
            m.oy = (real(r.h) - m.zoom * real(g.height)) / 2.0
            m.placed = true

        c.fill(r, BOARD)
        c.clip(r)

        val z = m.zoom
        val left = real(r.x) + m.ox
        val top = real(r.y) + m.oy

        c.stroke(Rect(int(left) - 1, int(top) - 1, int(z * real(g.width)) + 2, int(z * real(g.height)) + 2), EDGE)

        // A rule table gives state 0 a colour of its own, which the whole grid is laid in first.
        m.rule match
            Table(t) -> c.fill(Rect(int(left), int(top), int(z * real(g.width)), int(z * real(g.height))), t.colours[0])
            _ -> ()

        // Only the rows and columns that land inside the board are looked at.
        val y0 = max(0, int(((real(r.y) - top) / z).floor()))
        val y1 = min(g.height, int(((real(r.bottom()) - top) / z).ceil()))
        val x0 = max(0, int(((real(r.x) - left) / z).floor()))
        val x1 = min(g.width, int(((real(r.right()) - left) / z).ceil()))
        // From six points a cell up, a one-point gap separates rows, so a still life reads as cells.
        val gap = if z >= 6.0 then 1 else 0

        for y in y0..<y1
            val py = int(top + real(y) * z)
            val h = max(1, int(top + real(y + 1) * z) - py - gap)
            var x = x0

            while x < x1
                val state = g.state(x, y)

                if state != 0
                    val start = x

                    while x < x1 && g.state(x, y) == state
                        x += 1

                    val px = int(left + real(start) * z)

                    c.fill(Rect(px, py, max(1, int(left + real(x) * z) - px - gap), h), colour_of(m.rule, state))
                else
                    x += 1

        c.unclip()

        // A tap toggles the cell under it; a drag pans; the wheel zooms about the pointer.
        if c.tapped(r)
            val (tx, ty) = c.tap_point()

            m.grid.toggle(int(((real(tx) - left) / z).floor()), int(((real(ty) - top) / z).floor()))
            m.touched()

        val (dx, dy) = c.drag(r, 0, 3, 3)

        m.ox += real(dx)
        m.oy += real(dy)

        val (_, wy) = c.wheel(r)

        if wy != 0
            val (px, py) = c.pointer()
            val next = clamp(z * (1.0 + real(wy) / 200.0), 0.25, 64.0)
            val cx = (real(px) - left) / z
            val cy = (real(py) - top) / z

            m.zoom = next
            m.ox = real(px) - real(r.x) - cx * next
            m.oy = real(py) - real(r.y) - cy * next
    end paint

// The plane drawn into the board: only the tiles under it are looked at, and a row's run of live cells
// is one rectangle even where it crosses from one tile into the next.
private paint_plane(m: &Model, c: *Canvas, r: Rect)
    if m.fitting
        fit_plane(m, r)
        m.fitting = false

    // The first frame shows the region the grid would have, centred on the origin, at the grid's zoom;
    // so does a fit to an empty plane.
    if !m.placed
        val g = m.grid

        m.zoom = max(1.0, min(real(r.w) / real(g.width), real(r.h) / real(g.height)).floor())
        m.ox = (real(r.w) - m.zoom * real(g.width)) / 2.0
        m.oy = (real(r.h) - m.zoom * real(g.height)) / 2.0
        m.cx = -i64(g.width / 2)
        m.cy = -i64(g.height / 2)
        m.placed = true

    m.settle()
    c.fill(r, BOARD)
    c.clip(r)

    val z = m.zoom
    val left = real(r.x) + m.ox
    val top = real(r.y) + m.oy
    // How many cells across and down from the corner cell land inside the board.
    val across = i64(((real(r.right()) - left) / z).ceil())
    val down = int(((real(r.bottom()) - top) / z).ceil())
    val gap = if z >= 6.0 then 1 else 0
    val west = m.cx
    val east = m.cx + across

    if m.hashlife_on() then m.show(west, m.cy, across, i64(down))

    // Under the generic HashLife the plane is empty and the sheet holds the window.
    if m.multi_on() then paint_sheet(m, c, r, left, top, gap)

    val p = m.plane
    var slots: Buf[int] = buf()
    var band = i64(0)

    for j in 0..<down
        val y = m.cy + i64(j)
        val py = int(top + real(j) * z)
        val h = max(1, int(top + real(j + 1) * z) - py - gap)

        // The slots of the tiles along this row, looked up once for each row of tiles.
        if j == 0 || y >> 6 != band
            band = y >> 6
            slots.clear()

            for tx in (west >> 6)..((east - 1) >> 6)
                slots.push(p.slot(tx, band))

        // The run being drawn, cells `start ..< upto`, carried from one tile into the next while it
        // continues.
        var start = i64(0)
        var upto = i64(0)

        for t in 0..<slots.len()
            val base = ((west >> 6) + i64(t)) * 64
            var w = p.row(slots[t], int(y & 63)) & span(west - base, east - base)

            while w != 0
                val s = w.trailing_zeros()
                val n = (~(w >> u64(s))).trailing_zeros()
                val from = base + i64(s)

                if from != upto
                    if upto > start then fill_run(c, m, left, py, h, gap, start, upto)

                    start = from

                upto = from + i64(n)
                w = if s + n >= 64 then 0 else w & ~((u64(1) << u64(s + n)) - 1)

        if upto > start then fill_run(c, m, left, py, h, gap, start, upto)

    c.unclip()

    if c.tapped(r)
        val (tx, ty) = c.tap_point()

        m.toggle(m.cx + i64(((real(tx) - left) / z).floor()), m.cy + i64(((real(ty) - top) / z).floor()))

    val (dx, dy) = c.drag(r, 0, 3, 3)

    m.ox += real(dx)
    m.oy += real(dy)

    val (_, wy) = c.wheel(r)

    if wy != 0
        val (px, py) = c.pointer()
        val next = clamp(z * (1.0 + real(wy) / 200.0), 0.25, 64.0)
        val ax = (real(px) - left) / z
        val ay = (real(py) - top) / z

        m.zoom = next
        m.ox = real(px) - real(r.x) - ax * next
        m.oy = real(py) - real(r.y) - ay * next
end paint_plane

// The sheet drawn into the board from its corner cell at `left`, `top`, as the grid is drawn: a table's
// state 0 in its own colour first, then each row's runs of one state as one rectangle apiece.
private paint_sheet(m: &Model, c: *Canvas, r: Rect, left: real, top: real, gap: int)
    val g = m.sheet
    val z = m.zoom

    if m.rule is Table(t) then c.fill(r, t.colours[0])

    for y in 0..<g.height
        val py = int(top + real(y) * z)
        val h = max(1, int(top + real(y + 1) * z) - py - gap)
        var x = 0

        while x < g.width
            val state = g.state(x, y)

            if state != 0
                val start = x

                while x < g.width && g.state(x, y) == state
                    x += 1

                val px = int(left + real(start) * z)

                c.fill(Rect(px, py, max(1, int(left + real(x) * z) - px - gap), h), colour_of(m.rule, state))
            else
                x += 1
end paint_sheet

// Cells `start ..< end` of a row drawn as one rectangle, the plane's columns counted from the corner
// cell at `left`.
private fill_run(c: *Canvas, m: &Model, left: real, py: int, h: int, gap: int, start: i64, end: i64)
    val px = int(left + real(start - m.cx) * m.zoom)

    c.fill(Rect(px, py, max(1, int(left + real(end - m.cx) * m.zoom) - px - gap), h), LIVE)

// The bits of a tile's row from `lo` up to `hi`, each clamped into the row.
private span(lo: i64, hi: i64) -> u64 = below(hi) & ~below(lo)

// The bits under `n`.
private below(n: i64) -> u64 = if n <= 0 then 0 elif n >= 64 then ~u64(0) else (u64(1) << u64(n)) - 1

// The view zoomed and moved so the live cells' box fills the board with a cell to spare round it; on
// an empty plane, the first frame's view.
private fit_plane(m: &Model, r: Rect)
    val box = if m.hashlife_on() then m.hashed_bounds() else m.plane.bounds()

    box match
        Some((west, north, east, south)) ->
            val w = real(east - west + 1)
            val h = real(south - north + 1)
            var z = clamp(min(real(r.w) / (w + 2.0), real(r.h) / (h + 2.0)), 0.25, 64.0)

            if z >= 1.0 then z = z.floor()

            m.zoom = z
            m.cx = west
            m.cy = north
            m.ox = (real(r.w) - z * w) / 2.0
            m.oy = (real(r.h) - z * h) / 2.0
        None -> m.placed = false

// The colour a cell in `state` is drawn in: a table's own colours, or the one colour of a live cell,
// which the dying states of a Generations rule, and the decaying ones of Larger than Life and Weighted
// Life, fade from toward the board's. A cyclic rule's states go round a colour wheel.
private colour_of(rule: Rule, state: u8) -> u32 =
    rule match
        Table(t) -> t.colours[usize(state)]
        Generations(g) -> if state <= 1 then LIVE else mix(LIVE, BOARD, int(state) - 1, g.states - 1)
        LargerThanLife(l) -> if state <= 1 then LIVE else mix(LIVE, BOARD, int(state) - 1, l.states - 1)
        Weighted(w) -> if state <= 1 then LIVE else mix(LIVE, BOARD, int(state) - 1, w.states() - 1)
        BinaryLine(b) -> if state <= 1 then LIVE else mix(LIVE, BOARD, int(state) - 1, b.states() - 1)
        TotalisticLine(t) -> if state <= 1 then LIVE else mix(LIVE, BOARD, int(state) - 1, t.states() - 1)
        Cyclic(c) -> wheel(int(state), c.states)
        LifeLike(_, _) | Hex(_, _) | Isotropic(_) | Wolfram(_) | Vote(_) | Margolus(_) -> LIVE

// Colour `k` of `n` round a wheel of five hues that starts and ends at the live colour. State 0 is not
// drawn, and shows the board.
private wheel(k: int, n: int) -> u32
    val stops = [LIVE, 0x6FA8DC, 0xB48EAD, 0xE06C75, 0xE5C07B, LIVE]
    // Where `k` falls along the five stretches between the stops, in 64ths of a stretch.
    val at = k * 5 * 64 / n
    val i = at / 64

    mix(stops[usize(i)], stops[usize(i + 1)], at % 64, 64)

// What a frame does on its own: run as many generations as the speed owes.
tick(m: &Model, dt: real)
    if !m.running then return

    m.owed += dt * real(SPEEDS[m.speed])

    val n = min(MOST_PER_FRAME, int(m.owed))

    if n > 0
        m.owed -= real(n)
        m.advance(n)

    if m.owed > real(MOST_PER_FRAME) then m.owed = 0.0

// The keyboard's shortcuts. `true` says the event was dealt with, and the toolkit does not see it.
//
// While the rule field has the keyboard every key is the field's except Return, which applies what was
// typed, and Escape, which still quits.
shortcut(m: &Model, e: Event) -> bool
    if e.kind() != EventKind.KeyDown then return false

    val key = e.key_scancode()

    if key == SCANCODE_ESCAPE
        stop()
        return true

    if m.typing
        if key == SCANCODE_RETURN || key == SCANCODE_KP_ENTER
            m.use_rule(m.rule_text.read())
            return true

        return false

    if key == SCANCODE_SPACE
        m.running = !m.running
        m.owed = 0.0
        m.touched()
    elif key == SCANCODE_N
        m.running = false
        m.advance(1)
    elif key == SCANCODE_EQUALS || key == SCANCODE_KP_PLUS
        m.speed = min(int(SPEEDS.len) - 1, m.speed + 1)
        m.touched()
    elif key == SCANCODE_MINUS || key == SCANCODE_KP_MINUS
        m.speed = max(0, m.speed - 1)
        m.touched()
    elif key == SCANCODE_R
        m.randomize()
    elif key == SCANCODE_C
        m.clear()
    elif key == SCANCODE_T
        m.cycle_edges()
    elif key == SCANCODE_F
        m.fit()
    elif key == SCANCODE_H
        m.use_hashlife(!m.hashlife_on())
    elif key == SCANCODE_LEFTBRACKET
        m.step_size(m.step_log - 1)
    elif key == SCANCODE_RIGHTBRACKET
        m.step_size(m.step_log + 1)
    elif key >= SCANCODE_1 && key < SCANCODE_1 + 9
        val i = usize(key - SCANCODE_1)
        val rules = preset_rules()
        val patterns = bundled()

        if i < rules.len
            m.use_rule(rules[i])
        elif i - rules.len < usize(KEYED)
            m.load(parse_rle(patterns[i - rules.len]).unwrap())
    elif key == SCANCODE_0
        val patterns = bundled()

        m.load(parse_rle(patterns[usize(KEYED + m.more)]).unwrap())
        m.more = (m.more + 1) % (int(patterns.len) - KEYED)
    else
        return false

    true
end shortcut
